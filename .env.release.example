# Used only by scripts/release-production.ps1 on your computer.
# Copy this file to .env.release.local and replace both values.
# The .env.release.local file is ignored by Git and is not auto-loaded by Next.js.

# Use Neon's DIRECT (non-pooler) connection string for migrations.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# The public Vercel production URL, without a trailing slash.
NEXT_PUBLIC_APP_URL=https://workatlas-kappa.vercel.app

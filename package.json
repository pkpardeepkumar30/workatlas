{
  "name": "workatlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:verify": "node scripts/verify-build-assets.mjs",
    "start": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start",
    "start:standalone": "node --env-file-if-exists=.env .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "config:validate": "tsx scripts/validate-config.ts",
    "env:check": "node --env-file-if-exists=.env --import tsx scripts/check-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "check": "npm run env:check && npm run config:validate && npm run typecheck && npm run lint && npm run test && npm run db:check && npm run build && npm run build:verify"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "openai": "^6.47.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "description": "WorkAtlas is a project and knowledge workspace for research, software, publications, experiments, and long-term ideas.",
  "engines": {
    "node": ">=22.0.0"
  }
}
